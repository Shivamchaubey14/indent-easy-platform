{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "codegen": {
      "inputs": ["schema/**", "codegen.yml", "scripts/**"],
      "outputs": ["src/generated/**"]
    },
    "@ie/web#codegen": {
      "inputs": [
        "src/**/*.{ts,tsx}",
        "!src/generated/**",
        "codegen.ts",
        "$TURBO_ROOT$/packages/graphql/schema/**"
      ],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["codegen"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build", "codegen"]
    },
    "test": {
      "dependsOn": ["^build", "codegen"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build", "codegen"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "MIGRATION_DATABASE_URL", "REDIS_URL"]
    }
  },
  "globalPassThroughEnv": ["GITHUB_SHA", "CI"]
}
