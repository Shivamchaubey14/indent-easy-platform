{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "codegen": {
      "inputs": ["schema/**", "codegen.yml", "scripts/**"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["codegen"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "codegen"]
    },
    "typecheck": {
      "dependsOn": ["^build", "codegen"]
    },
    "test": {
      "dependsOn": ["^build", "codegen"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build", "codegen"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "MIGRATION_DATABASE_URL"]
    }
  },
  "globalPassThroughEnv": ["GITHUB_SHA", "CI"]
}
