{
  "name": "@ie/domain-types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared domain vocabulary: error catalogue, business time, value objects.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
