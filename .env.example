# Local development values matching infrastructure/docker/compose.yaml.
# Full variable contract: docs/srs/Indent-Easy-SRS.md §55.2. Never commit a real .env.
NODE_ENV=development
APP_ENV=dev
PORT=4000
METRICS_PORT=9464
PUBLIC_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# The app connects as ie_app (row-level security applies); migrations run as the owner.
DATABASE_URL=postgres://ie_app:ie_app_local_only@localhost:5432/indent_easy
MIGRATION_DATABASE_URL=postgres://ie:ie_local_only@localhost:5432/indent_easy
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6380

S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET_DOCUMENTS=ie-documents
S3_BUCKET_EXPORTS=ie-exports
S3_BUCKET_IMPORTS=ie-imports
S3_BUCKET_QUARANTINE=ie-quarantine
S3_ACCESS_KEY_ID=ie_minio
S3_SECRET_ACCESS_KEY=ie_minio_local_only

JWT_SIGNING_KEYS=
JWT_ACCESS_TTL_SECONDS=600
CSRF_SECRET=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Indent Easy <no-reply@indent-easy.local>"

SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=

GOTENBERG_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Kolkata
GRAPHQL_MAX_DEPTH=10
GRAPHQL_MAX_COST=5000
GRAPHQL_PERSISTED_ONLY=false
GRAPHQL_INTROSPECTION=true
